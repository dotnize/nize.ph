---
import IconEmail from "#/components/icons/IconEmail.astro";

import IconPhone from "./icons/IconPhone.astro";
---

<footer class="mt-24 pb-10 select-none">
  <div>let's work together</div>

  <div>
    <a class="group text-accent" href="mailto:nat@nize.ph" title="Email">
      <IconEmail class="inline size-4" />
      <span class="select-all group-hover:underline"> nat@nize.ph</span>
    </a>
    <span>&ThinSpace;&ThinSpace;or&ThinSpace;&ThinSpace;</span>
    <a
      class="group text-accent"
      title="Book a call on Cal.com"
      href="https://cal.com/mugnavo"
      target="_blank"
      rel="noopener noreferrer"
    >
      <IconPhone class="inline size-4" />
      <span class="group-hover:underline"> book a call</span>
    </a>
  </div>
</footer>

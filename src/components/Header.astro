---
import { Image } from "astro:assets";
---

<div class="flex items-center pt-10 sm:pt-14">
  <a
    href="/"
    class="bg-pfp transition-[border-radius,translate] duration-200 dark:rounded-[22px] dark:hover:-translate-y-1"
  >
    <Image
      src="/images/nize.webp"
      alt="nize's avatar"
      width={44}
      height={44}
      loading="eager"
      decoding="async"
      class="rounded-md nb-shadow-on outline-1 outline-foreground transition-[border-radius,box-shadow] duration-200 hover:shadow-none dark:rounded-[22px] dark:shadow-none dark:outline-0"
    />
  </a>
</div>

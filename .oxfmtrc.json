{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "semi": true,
  "printWidth": 100,
  "singleQuote": false,
  "endOfLine": "lf",
  "trailingComma": "all",
  "astro": true,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./src/layouts/base.css",
    "attributes": ["class", "class:list"]
  },
  "sortPackageJson": true,
  "ignorePatterns": ["pnpm-lock.yaml", "dist", ".astro", ".vercel", ".cache"]
}

    "@expressive-code/plugin-collapsible-sections": "0.44.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@vercel/analytics": "2.0.1",
    "astro": "7.4.13",
    "astro-expressive-code": "0.44.4",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
